{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!launch\\.css$|favicon\\.svg$).*)",
      "has": [
        {
          "type": "host",
          "value": "servicehub.o7digitalgroup.com"
        }
      ],
      "destination": "/launch.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://service-hub-dev-3fbf.up.railway.app/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://service-hub-dev-3fbf.up.railway.app/health"
    },
    {
      "source": "/cliente",
      "destination": "/index.html"
    },
    {
      "source": "/cliente/",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/signup",
      "destination": "/index.html"
    },
    {
      "source": "/pricing",
      "destination": "/index.html"
    },
    {
      "source": "/onboarding",
      "destination": "/index.html"
    },
    {
      "source": "/settings",
      "destination": "/index.html"
    },
    {
      "source": "/subscription",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/invitation",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/forgot-password",
      "destination": "/index.html"
    },
    {
      "source": "/reset-password",
      "destination": "/index.html"
    },
    {
      "source": "/verify-email",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": false
  },
  "redirects": [
    {
      "source": "/demo",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/demo/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/demo.html",
      "destination": "/",
      "permanent": true
    }
  ]
}
